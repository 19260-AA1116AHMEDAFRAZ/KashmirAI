# Copy this file to .env.local and fill in your values. Same Supabase project as the mobile app (KashmirAI/.env).
# Only PUBLIC values: anything starting with NEXT_PUBLIC_ is sent to the browser.
# NEVER put the secret / service_role key, database password or Google client secret here.
# Restart `npm run dev` after changing this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
